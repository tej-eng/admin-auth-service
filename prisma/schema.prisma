generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApprovalStatus {
  PENDING
  INTERVIEW
  DOCUMENT_VERIFICATION
  APPROVED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  PASSED
  FAILED
  RESCHEDULED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  ID_PROOF
  CERTIFICATE
  EXPERIENCE_PROOF
}

enum RejectionStage {
  PROFILE
  INTERVIEW
  DOCUMENT
}

model User {
  id            String    @id @default(uuid())
  name          String?
  countryCode   String?   
  mobile        String?   @unique
  gender        Gender?
  birthDate     DateTime?
  birthTime     String?
  occupation    String?
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  refreshToken  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  intakes        Intake[]
  wallet        UserWallet?
  payments      Payment[]
  paymentOrders PaymentOrder[]
  sessions      Session[]
  reviews Review[]
 @@unique([countryCode, mobile])
}
model Review {
  id            String   @id @default(uuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  astrologerId  String
  astrologer    Astrologer @relation(fields: [astrologerId], references: [id])

  sessionId     String?  @unique   // REQUIRED
  session       Session? @relation(fields: [sessionId], references: [id])

  rating        Int
  comment       String?

  userName      String?
  astroName     String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([astrologerId])
}

model Intake {
  id           String   @id @default(uuid())
  userId       String
  astrologerId String
  chatId       String?
  name         String
  countryCode String
  mobile       String
  gender       Gender?
  birthDate    DateTime
  birthTime    String
  occupation   String
  birthPlace   String
  requestType  String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])
  @@index([userId])
  @@index([astrologerId])
}

model Astrologer {
  id           String  @id @default(uuid())
  name         String
  displayName  String
  profilePic   String?
  gender       Gender
  email        String  @unique
  contactNo    String
  password     String
  experience   Int
  aboutEnglish String
  languages String[]
  skills    String[]
  problems  String[]
  callChatCharges              Float
  callChatOfferCharges         Float
  callChatCommission           Float
  videocall_charges            Float
  audiocall_charges            Float
  audiovideocall_offer_charges Float
  tags  String
  vtags String
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses   Address[]
  bankDetails BankDetails?
  documents   AstrologerDocument[]
  createdById String?
  createdBy   Staff?  @relation("CreatedAstrologers", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   Staff?  @relation("ApprovedAstrologers", fields: [approvedById], references: [id])
  experiences  ExperiencePlatform[]
  interviews   Interview[]
  wallet       AstrologerWallet?
  sessions     Session[]
  refreshToken String?
}

model AstrologerApproved {
  id         Int     @id @default(autoincrement())
  name       String
  profilePic String
  experience Int
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([name])           
  @@index([experience])     
  @@index([isActive])       
}

model Address {
  id           Int        @id @default(autoincrement())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  street  String
  city    String
  state   String
  country String
  pincode String

  @@index([astrologerId])  
  @@index([city])           
  @@index([pincode])        
}

model BankDetails {
  id           Int    @id @default(autoincrement())
  astrologerId String @unique

  accountHolderName String
  accountNumber     String
  bankName          String
  ifscCode          String
  panCardNumber     String
  branchName        String

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])
}

model ExperiencePlatform {
  id           Int        @id @default(autoincrement())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  platformName String
  yearsWorked  Int

  @@index([astrologerId])   
  @@index([platformName])   
}

model Interview {
  id             Int             @id @default(autoincrement())
  astrologerId   String
  astrologer     Astrologer      @relation(fields: [astrologerId], references: [id])

  roundNumber     Int
  interviewerName String
  scheduledAt     DateTime
  status          InterviewStatus @default(SCHEDULED)
  remarks         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([astrologerId])                     
  @@index([scheduledAt])                      
  @@index([status])                           
  @@unique([astrologerId, roundNumber])      
}

model AstrologerDocument {
  id           Int          @id @default(autoincrement())
  astrologerId String
  astrologer   Astrologer   @relation(fields: [astrologerId], references: [id])

  documentType DocumentType
  documentUrl  String
  status       DocumentStatus @default(PENDING)
  verifiedBy   String?
  verifiedAt   DateTime?
  remarks      String?

  createdAt DateTime @default(now())

  @@index([astrologerId])                     
  @@index([status])                           
  @@unique([astrologerId, documentType])     
}

model AstrologerRejectionHistory {
  id           Int        @id @default(autoincrement())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  stage      RejectionStage
  reason     String
  rejectedBy String

  createdAt DateTime @default(now())

  @@index([astrologerId])  
  @@index([stage])          
}

enum AdminRole {
  SUPER_ADMIN
  SUB_ADMIN
  MANAGER
  SUPPORT
}

model Admin {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  phoneNo             String       @unique
  department          String?
  roleId              String
  password            String?      // hashed password
  isActive            Boolean      @default(true)
  isDeleted           Boolean      @default(false)
  refreshToken        String?      @db.Text
  approvedAstrologers Astrologer[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  @@index([roleId])       
  @@index([isActive])     
  @@index([isDeleted])  
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff       Staff[]
  permissions RolePermission[]

  @@index([name])
  @@index([slug])
}



model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  //  NEW FIELD
  type PermissionType @default(SYSTEM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles            RolePermission[]
  modules          ModulePermission[]
  staffPermissions StaffPermission[]

  isDeleted Boolean @default(false)

  @@index([name])
  @@index([type])
}
model ModulePermission {
  id String @id @default(uuid())

  moduleId     String
  permissionId String

  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([moduleId, permissionId])
}

model Module {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  isActive    Boolean            @default(true)
  section     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  permissions ModulePermission[]

  // permissions ModulePermission[]
  isDeleted Boolean @default(false)

  @@index([name])
  @@index([slug])
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffMembers Staff[]
  isDeleted    Boolean @default(false)
}
model Staff {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  permissions StaffPermission[]

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdAstrologers  Astrologer[] @relation("CreatedAstrologers")
  approvedAstrologers Astrologer[] @relation("ApprovedAstrologers")

  @@index([roleId])
  @@index([departmentId])
}

model StaffPermission {
  id String @id @default(uuid())

  staffId      String
  permissionId String

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([staffId, permissionId])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  services Service[]

  createdAt DateTime @default(now())
}

model Service {
  id   String      @id @default(cuid())
  name String
  slug String      @unique
  type ServiceType

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  image       String?
  description String?
  longText    String?
  price       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum ServiceType {
  CATEGORY
  DIRECT_SERVICE
}

model Gift {
  id     String  @id @default(cuid())
  name   String
 amount Float
  image  String?
  status String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
} 
model Testimonial {
  id        String   @id @default(uuid())
  name      String
  address   String?
  content   String
  image     String?
  rating    Int // 1 to 5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Banner {
  id         String  @id @default(uuid())
  heading    String
  subheading String
  slug       String  @unique
  sortorder  Int
  bannerlink String
  language   String  @default("en")
  imageUrl   String
  status     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RechargePack {
  id           String   @id @default(uuid())
  name         String
  description  String?
  price        Float
  coins        Int
  talktime     Int
  validityDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
  payments     Payment[]
  paymentOrders PaymentOrder[]
  coupons       Coupon[]
  @@index([isActive])
  @@index([price])
  @@index([coins])
  @@index([createdAt])
}

model UserWallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])

  balanceCoins Float      @default(0)
  lockedCoins  Float      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

model AstrologerWallet {
  id              String     @id @default(uuid())
  astrologerId    String     @unique
  astrologer      Astrologer @relation(fields: [astrologerId], references: [id])
  balanceCoins    Float        @default(0)
  totalEarned     Int        @default(0)
  totalWithdrawn  Int        @default(0)
   withdrawals     Withdrawal[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  transactions WalletTransaction[]

  @@index([astrologerId])
}

model WalletTransaction {
  id                String   @id @default(uuid())

  userWalletId      String?
  userWallet        UserWallet? @relation(fields: [userWalletId], references: [id])

  astrologerWalletId String?
  astrologerWallet   AstrologerWallet? @relation(fields: [astrologerWalletId], references: [id])

  rechargePackId    String?
  rechargePack      RechargePack? @relation(fields: [rechargePackId], references: [id])

  sessionId         String?
  session           Session? @relation(fields: [sessionId], references: [id])

  //  ADD THIS (CRITICAL)
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  type              TransactionType
  coins             Int
  amount            Float?
  description       String?

  createdAt         DateTime @default(now())

  @@index([userWalletId])
  @@index([astrologerWalletId])
  @@index([sessionId])
  @@index([paymentId])
  @@index([createdAt])

  //  PREVENT duplicate credit from same payment
  @@unique([paymentId, type])
}

enum TransactionType {
  CREDIT
  DEBIT
}

model Withdrawal {
  id                String @id @default(uuid())

  astrologerWalletId String
  astrologerWallet  AstrologerWallet @relation(fields: [astrologerWalletId], references: [id])

  amount            Float
  coins             Int

  status            WithdrawalStatus

  requestedAt       DateTime @default(now())
  processedAt       DateTime?

  transactionRef    String?

  @@index([astrologerWalletId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Session {
  id            String   @id @default(uuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  astrologerId  String
  astrologer    Astrologer @relation(fields: [astrologerId], references: [id])

  type          SessionType
  status        SessionStatus

  ratePerMin    Int
  durationSec   Int      @default(0)

  coinsDeducted Int      @default(0)
  coinsEarned   Int      @default(0)
  commission    Int      @default(0)
  review Review?
  startedAt     DateTime?
  endedAt       DateTime?
  messages      Message[]
  createdAt     DateTime @default(now())
  transactions  WalletTransaction[]
  @@index([userId])
  @@index([astrologerId])
  @@index([status])
  @@index([createdAt])
}

enum SessionType {
  CHAT
  CALL
}

enum SessionStatus {
  REQUESTED
  ACCEPTED
  ONGOING
  COMPLETED
  CANCELLED
  FAILED
}

model Payment {
  id                String   @id @default(uuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id])

  rechargePackId    String
  rechargePack      RechargePack @relation(fields: [rechargePackId], references: [id])

  paymentOrderId    String   @unique
  paymentOrder      PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  amount            Float
  coins             Int

  provider          PaymentProvider

  razorpayOrderId   String
  razorpayPaymentId String   @unique

  status            PaymentStatus

  createdAt         DateTime @default(now())

  // ADD THIS
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  CASHFREE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

model PaymentOrder {
  id              String   @id @default(uuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  rechargePackId  String
  rechargePack    RechargePack @relation(fields: [rechargePackId], references: [id])

  razorpayOrderId String   @unique

  amount          Float
  coins           Int

  status          PaymentOrderStatus @default(CREATED)

  payment         Payment?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
}
model CommissionConfig {
  id            String  @id @default(uuid())

  chatPercent   Float
  callPercent   Float

  createdAt     DateTime @default(now())

  // only one config active
  @@unique([createdAt])
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum CouponVisibility {
  PUBLIC
  PRIVATE
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  description   String?

  type          CouponType
  visibility    CouponVisibility
  status        Boolean  @default(true)

  percentage    Float?
  flatAmount    Float?
  maxDiscount   Float?

  minOrderAmount Float?
  redeemLimit   Int?
  usedCount     Int      @default(0)

  startDate     DateTime
  endDate       DateTime

  rechargePacks RechargePack[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Message {
  id            String   @id @default(uuid())

  msgId         String
  roomId        String

  senderId      String
  receiverId    String?

  message       String
  image         String?
  sender        String

  replyTo       Json?

  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id])

  createdAt     DateTime @default(now())

  @@index([roomId])
  @@index([sessionId])
  @@index([senderId])
}
