generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String?
  countryCode   String?
  mobile        String?        @unique
  gender        Gender?
  birthDate     DateTime?
  birthTime     String?
  occupation    String?
  isActive      Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  refreshToken  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  intakes       Intake[]
  payments      Payment[]
  paymentOrders PaymentOrder[]
  reviews       Review[]
  sessions      Session[]
  wallet        UserWallet?

  @@unique([countryCode, mobile])
}

model Review {
  id           String     @id @default(uuid())
  userId       String
  astrologerId String
  sessionId    String?    @unique
  rating       Int
  comment      String?
  userName     String?
  astroName    String?
  createdAt    DateTime   @default(now())
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])
  session      Session?   @relation(fields: [sessionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([astrologerId])
}

model Intake {
  id           String     @id @default(uuid())
  userId       String
  astrologerId String
  chatId       String?
  name         String
  countryCode  String
  mobile       String
  gender       Gender?
  birthDate    DateTime
  birthTime    String
  occupation   String
  birthPlace   String
  requestType  String
  createdAt    DateTime   @default(now())
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([astrologerId])
}

model Astrologer {
  id           String              @id @default(uuid())
  name         String
  displayName  String
  profilePic   String?
  gender       Gender
  email        String              @unique
  contactNo    String
  password     String
  experience   Int
  aboutEnglish String
  languages    String[]
  skills       String[]
  problems     String[]
  pricing      AstrologerPricing[]

  tags                   String
  vtags                  String
  approvalStatus         ApprovalStatus               @default(PENDING)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  refreshToken           String?
  approvedById           String?
  createdById            String?
  addresses              Address[]
  approvedBy             Staff?                       @relation("ApprovedAstrologers", fields: [approvedById], references: [id])
  createdBy              Staff?                       @relation("CreatedAstrologers", fields: [createdById], references: [id])
  documents              AstrologerDocument[]
  rejectionHistory       AstrologerRejectionHistory[]
  wallet                 AstrologerWallet?
  bankDetails            BankDetails?
  experiences            ExperiencePlatform[]
  intakes                Intake[]
  interviews             Interview[]
  reviews                Review[]
  sessions               Session[]
  astrologerCommissionId String?
}

model AstrologerApproved {
  id         Int      @id @default(autoincrement())
  name       String
  profilePic String
  experience Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([name])
  @@index([experience])
  @@index([isActive])
}

model Address {
  id           Int        @id @default(autoincrement())
  astrologerId String
  street       String
  city         String
  state        String
  country      String
  pincode      String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId])
  @@index([city])
  @@index([pincode])
}

model BankDetails {
  id                Int        @id @default(autoincrement())
  astrologerId      String     @unique
  accountHolderName String
  accountNumber     String
  bankName          String
  ifscCode          String
  panCardNumber     String
  branchName        String
  astrologer        Astrologer @relation(fields: [astrologerId], references: [id])
}

model ExperiencePlatform {
  id           Int        @id @default(autoincrement())
  astrologerId String
  platformName String
  yearsWorked  Int
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId])
  @@index([platformName])
}

model Interview {
  id              Int             @id @default(autoincrement())
  astrologerId    String
  roundNumber     Int
  interviewerName String
  scheduledAt     DateTime
  status          InterviewStatus @default(SCHEDULED)
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  astrologer      Astrologer      @relation(fields: [astrologerId], references: [id])

  @@unique([astrologerId, roundNumber])
  @@index([astrologerId])
  @@index([scheduledAt])
  @@index([status])
}

model AstrologerDocument {
  id           Int            @id @default(autoincrement())
  astrologerId String
  documentType DocumentType
  documentUrl  String
  status       DocumentStatus @default(PENDING)
  verifiedBy   String?
  verifiedAt   DateTime?
  remarks      String?
  createdAt    DateTime       @default(now())
  astrologer   Astrologer     @relation(fields: [astrologerId], references: [id])

  @@unique([astrologerId, documentType])
  @@index([astrologerId])
  @@index([status])
}

model AstrologerRejectionHistory {
  id           Int            @id @default(autoincrement())
  astrologerId String
  stage        RejectionStage
  reason       String
  rejectedBy   String
  createdAt    DateTime       @default(now())
  astrologer   Astrologer     @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId])
  @@index([stage])
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phoneNo      String   @unique
  department   String?
  roleId       String
  password     String?
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([isActive])
  @@index([isDeleted])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isActive    Boolean          @default(true)
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  admins      Admin[]
  permissions RolePermission[]
  staff       Staff[]

  @@index([name])
  @@index([slug])
}

model Permission {
  id               String             @id @default(uuid())
  name             String             @unique
  description      String?
  type             PermissionType     @default(SYSTEM)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  isDeleted        Boolean            @default(false)
  modules          ModulePermission[]
  roles            RolePermission[]
  staffPermissions StaffPermission[]

  @@index([name])
  @@index([type])
}

model ModulePermission {
  id           String     @id @default(uuid())
  moduleId     String
  permissionId String
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([moduleId, permissionId])
}

model Module {
  id          String             @id @default(uuid())
  name        String             @unique
  slug        String             @unique
  description String?
  isActive    Boolean            @default(true)
  section     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  isDeleted   Boolean            @default(false)
  permissions ModulePermission[]

  @@index([name])
  @@index([slug])
}

model Department {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)
  staffMembers Staff[]
}

model Staff {
  id                  String            @id @default(uuid())
  name                String
  email               String            @unique
  password            String
  roleId              String
  departmentId        String
  isActive            Boolean           @default(true)
  isDeleted           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  approvedAstrologers Astrologer[]      @relation("ApprovedAstrologers")
  createdAstrologers  Astrologer[]      @relation("CreatedAstrologers")
  department          Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role                Role              @relation(fields: [roleId], references: [id])
  permissions         StaffPermission[]

  @@index([roleId])
  @@index([departmentId])
}

model StaffPermission {
  id           String     @id @default(uuid())
  staffId      String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, permissionId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  services  Service[]
}

model Service {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  type        ServiceType
  categoryId  String?
  image       String?
  description String?
  longText    String?
  price       Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Category?   @relation(fields: [categoryId], references: [id])
}

model Gift {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  image     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  address   String?
  content   String
  image     String?
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String   @id @default(uuid())
  heading    String
  subheading String
  slug       String   @unique
  sortorder  Int
  bannerlink String
  language   String   @default("en")
  imageUrl   String
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RechargePack {
  id            String              @id @default(uuid())
  name          String
  description   String?
  price         Float
  coins         Int
  talktime      Int
  validityDays  Int
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  payments      Payment[]
  paymentOrders PaymentOrder[]
  transactions  WalletTransaction[]
  coupons       Coupon[]            @relation("CouponToRechargePack")

  @@index([isActive])
  @@index([price])
  @@index([coins])
  @@index([createdAt])
}

model UserWallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balanceCoins Float               @default(0)
  lockedCoins  Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model AstrologerWallet {
  id             String              @id @default(uuid())
  astrologerId   String              @unique
  balanceCoins   Float               @default(0)
  totalEarned    Int                 @default(0)
  totalWithdrawn Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  astrologer     Astrologer          @relation(fields: [astrologerId], references: [id])
  transactions   WalletTransaction[]
  withdrawals    Withdrawal[]

  @@index([astrologerId])
}

model WalletTransaction {
  id                 String            @id @default(uuid())
  userWalletId       String?
  astrologerWalletId String?
  rechargePackId     String?
  sessionId          String?
  paymentId          String?
  type               TransactionType
  coins              Int
  amount             Float?
  description        String?
  createdAt          DateTime          @default(now())
  astrologerWallet   AstrologerWallet? @relation(fields: [astrologerWalletId], references: [id])
  payment            Payment?          @relation(fields: [paymentId], references: [id])
  rechargePack       RechargePack?     @relation(fields: [rechargePackId], references: [id])
  session            Session?          @relation(fields: [sessionId], references: [id])
  userWallet         UserWallet?       @relation(fields: [userWalletId], references: [id])

  @@unique([paymentId, type])
  @@index([userWalletId])
  @@index([astrologerWalletId])
  @@index([sessionId])
  @@index([paymentId])
  @@index([createdAt])
}

model Withdrawal {
  id                 String           @id @default(uuid())
  astrologerWalletId String
  amount             Float
  coins              Int
  status             WithdrawalStatus
  requestedAt        DateTime         @default(now())
  processedAt        DateTime?
  transactionRef     String?
  astrologerWallet   AstrologerWallet @relation(fields: [astrologerWalletId], references: [id])

  @@index([astrologerWalletId])
  @@index([status])
}

model Session {
  id            String              @id @default(uuid())
  userId        String
  astrologerId  String
  type          SessionType
  status        SessionStatus
  ratePerMin    Int
  durationSec   Int                 @default(0)
  coinsDeducted Int                 @default(0)
  coinsEarned   Int                 @default(0)
  commission    Int                 @default(0)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime            @default(now())
  messages      Message[]
  review        Review?
  astrologer    Astrologer          @relation(fields: [astrologerId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  transactions  WalletTransaction[]

  @@index([userId])
  @@index([astrologerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                 String              @id @default(uuid())
  userId             String
  rechargePackId     String
  paymentOrderId     String              @unique
  amount             Float
  coins              Int
  provider           PaymentProvider
  razorpayOrderId    String
  razorpayPaymentId  String              @unique
  status             PaymentStatus
  createdAt          DateTime            @default(now())
  paymentOrder       PaymentOrder        @relation(fields: [paymentOrderId], references: [id])
  rechargePack       RechargePack        @relation(fields: [rechargePackId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

model PaymentOrder {
  id              String             @id @default(uuid())
  userId          String
  rechargePackId  String
  razorpayOrderId String             @unique
  amount          Float
  coins           Int
  status          PaymentOrderStatus @default(CREATED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  payment         Payment?
  rechargePack    RechargePack       @relation(fields: [rechargePackId], references: [id])
  user            User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
}

model Coupon {
  id             String           @id @default(uuid())
  code           String           @unique
  description    String?
  type           CouponType
  visibility     CouponVisibility
  status         Boolean          @default(true)
  percentage     Float?
  flatAmount     Float?
  maxDiscount    Float?
  minOrderAmount Float?
  redeemLimit    Int?
  usedCount      Int              @default(0)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rechargePacks  RechargePack[]   @relation("CouponToRechargePack")
}

model Message {
  id         String   @id @default(uuid())
  msgId      String
  roomId     String
  senderId   String
  receiverId String?
  message    String
  image      String?
  sender     String
  replyTo    Json?
  sessionId  String?
  createdAt  DateTime @default(now())
  session    Session? @relation(fields: [sessionId], references: [id])

  @@index([roomId])
  @@index([sessionId])
  @@index([senderId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApprovalStatus {
  PENDING
  INTERVIEW
  DOCUMENT_VERIFICATION
  APPROVED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  PASSED
  FAILED
  RESCHEDULED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  PASSBOOK
  PROFILE
}

enum RejectionStage {
  PROFILE
  INTERVIEW
  DOCUMENT
}

enum AdminRole {
  SUPER_ADMIN
  SUB_ADMIN
  MANAGER
  SUPPORT
}

enum ServiceType {
  CATEGORY
  DIRECT_SERVICE
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionType {
  CHAT
  CALL
}

enum SessionStatus {
  REQUESTED
  ACCEPTED
  ONGOING
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  CASHFREE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum CouponVisibility {
  PUBLIC
  PRIVATE
}

enum PermissionType {
  SYSTEM
  CUSTOM
}

// ----------------------------------price call chat 

model AstrologerPricing {
  id                String      @id @default(uuid())
  astrologerId      String
  type              PricingType
  price             Float
  offerPrice        Float?
  commissionPercent Float?
  isActive          Boolean     @default(true)

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@unique([astrologerId, type])
}

enum PricingType {
  CHAT
  CALL
  VIDEO
  AUDIO
}
